config BACKPORTS_ATH11K
	tristate "Qualcomm Atheros 11ac/11ax wireless support (ath11k)"
	depends on BACKPORTS_ATH_DRIVERS && BACKPORTS_MAC80211 && HAS_DMA
	select BACKPORTS_WIRELESS_CRYPTO
	select BACKPORTS_WIRELESS_REGULATORY
	help
	  This module adds support for Qualcomm Atheros 11ac/11ax wireless
	  chipsets including QCA6390, QCA6490, WCN6855, and QCN9074.

	  ath11k supports:
	  - 802.11ac Wave 2 and 802.11ax (Wi-Fi 6) features
	  - Multi-user MIMO (MU-MIMO) and OFDMA
	  - Advanced power management
	  - Monitor mode and packet injection
	  - Mesh networking
	  - WPA3 and enhanced security features

	  Supported chipsets:
	  - QCA6390: PCIe 802.11ax 2x2 with Bluetooth
	  - QCA6490: PCIe 802.11ax 2x2 with Bluetooth
	  - WCN6855: PCIe 802.11ax 2x2 with Bluetooth
	  - QCN9074: PCIe 802.11ax 4x4 enterprise

	  Say M to build ath11k as a module, Y to build into kernel.

