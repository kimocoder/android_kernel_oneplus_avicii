#
# Wireless Drivers Configuration
#
# This section provides configuration options for modern wireless drivers
# that are backported from newer kernels, including ath11k, ath10k, iwlwifi,
# and other wireless driver families.
#

menuconfig BACKPORTS_WIRELESS_DRIVERS
	bool "Enable Wireless Drivers Support"
	depends on BACKPORTS && BACKPORTS_MAC80211 && BACKPORTS_CFG80211
	help
	  Enable support for modern wireless drivers backported from newer kernels.
	  This includes comprehensive support for Qualcomm Atheros, Intel, Ralink,
	  and other wireless chipset families.

	  Supported driver families:
	  - ath11k: Qualcomm Atheros 11ac/11ax (QCA6390, QCA6490, WCN6855, QCN9074)
	  - ath10k: Qualcomm Atheros 11ac (QCA988X, QCA6174, QCA9377, QCA4019)
	  - ath9k: Qualcomm Atheros legacy (AR9280, AR9285, AR9287, AR9380)
	  - iwlwifi: Intel wireless (7260, 8260, 9260, AX200, AX210)
	  - rt2x00: Ralink/MediaTek (RT2500, RT2800, RT3070, RT5370)

	  Features include:
	  - Monitor mode and packet injection
	  - Mesh networking support
	  - Advanced security features
	  - Firmware management
	  - Power management optimization
	  - Regulatory compliance

	  Say Y to enable wireless drivers support.

#
# Wireless Stack Configuration
# (All options depend on BACKPORTS_WIRELESS_DRIVERS)
#

config BACKPORTS_WIRELESS_REGULATORY
	bool "Enhanced regulatory domain support"
	depends on BACKPORTS_WIRELESS_DRIVERS && BACKPORTS_CFG80211
	default y
	help
	  Enable enhanced regulatory domain support for wireless drivers.
	  This provides comprehensive regulatory compliance features including
	  dynamic regulatory domain updates, country code management, and
	  power limit enforcement.

	  Features include:
	  - Dynamic regulatory domain switching
	  - Country code detection and enforcement
	  - Power limit and channel restriction management
	  - Regulatory database integration
	  - DFS (Dynamic Frequency Selection) support
	  - Compliance with regional regulations

	  This is required for proper wireless operation in different
	  countries and regions.

	  Say Y to enable enhanced regulatory support.

config BACKPORTS_WIRELESS_CRYPTO
	bool "Enhanced wireless cryptography support"
	depends on BACKPORTS_WIRELESS_DRIVERS && BACKPORTS_MAC80211
	select CRYPTO_AES
	select CRYPTO_ARC4
	select CRYPTO_ECB
	select CRYPTO_CMAC
	select CRYPTO_CCMP
	select CRYPTO_GCMP
	default y
	help
	  Enable enhanced cryptography support for modern wireless security
	  protocols. This includes support for WPA3, SAE, OWE, and other
	  advanced security features.

	  Supported security protocols:
	  - WPA3 Personal and Enterprise
	  - SAE (Simultaneous Authentication of Equals)
	  - OWE (Opportunistic Wireless Encryption)
	  - Enhanced Open
	  - 802.11w Management Frame Protection
	  - GCMP-256 and CCMP-256 encryption

	  This automatically selects required crypto modules for
	  wireless security operations.

	  Say Y to enable enhanced wireless cryptography.

config BACKPORTS_WIRELESS_MESH
	bool "Enhanced mesh networking support"
	depends on BACKPORTS_WIRELESS_DRIVERS && BACKPORTS_MAC80211_MESH
	default y
	help
	  Enable enhanced mesh networking support with advanced features
	  for 802.11s mesh networks and proprietary mesh protocols.

	  Enhanced mesh features:
	  - 802.11s mesh networking with path selection
	  - Mesh security with SAE authentication
	  - Multi-hop mesh routing optimization
	  - Mesh power save mechanisms
	  - Mesh peering and authentication
	  - Airtime-based path selection

	  This extends the basic mesh support with advanced features
	  required for production mesh deployments.

	  Say Y to enable enhanced mesh networking.

