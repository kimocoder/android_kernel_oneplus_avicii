#
# Linux Kernel Backports Configuration
#
# This file provides configuration options for integrating modern wireless
# stack components (cfg80211/mac80211 from kernel 6.1) into kernel 4.19.
#

menuconfig BACKPORTS
	bool "Enable Linux Kernel Backports"
	depends on (!CFG80211 && !MAC80211) || EXPERT
	help
	  Enable modern wireless stack backported from newer kernels.
	  This provides cfg80211/mac80211 from kernel 6.1 on kernel 4.19.

	  Backports allow you to use newer wireless drivers and features
	  on older kernel versions. This is particularly useful for:
	  - Modern wireless security protocols
	  - Enhanced monitor mode support
	  - Frame injection capabilities
	  - Better wireless debugging tools

	  Say Y here to enable backports support.

	  NOTE: Backports cannot be enabled simultaneously with the existing
	  cfg80211 and mac80211 drivers unless EXPERT mode is enabled.
	  In EXPERT mode, you can choose between backports and legacy drivers,
	  but only one set should be enabled at a time.

	  If unsure, say N.

config BACKPORTS_VERSION
	string
	depends on BACKPORTS
	default "6.1"
	help
	  Version of the kernel from which wireless components are backported.

config BACKPORTS_CFG80211
	tristate "cfg80211 - wireless configuration API"
	depends on BACKPORTS
	help
	  cfg80211 is the Linux wireless LAN configuration API.
	  It provides a unified interface for wireless device configuration
	  and management.

	  This backported version includes:
	  - Modern regulatory domain support
	  - Enhanced security features
	  - Better power management
	  - Improved roaming capabilities

	  Say M to build cfg80211 as a module, Y to build it into the kernel,
	  or N to disable it.

config BACKPORTS_MAC80211
	tristate "Generic IEEE 802.11 Networking Stack (mac80211)"
	depends on BACKPORTS_CFG80211
	help
	  This option enables the hardware independent IEEE 802.11
	  networking stack (mac80211).

	  This backported version provides:
	  - Modern 802.11 protocol support (802.11ac, 802.11ax features)
	  - Enhanced aggregation and AMPDU support
	  - Better power save mechanisms
	  - Improved mesh networking
	  - Advanced QoS features

	  Say M to build mac80211 as a module, Y to build it into the kernel,
	  or N to disable it.

config BACKPORTS_MAC80211_RC_MINSTREL
	bool "Minstrel rate control algorithm"
	depends on BACKPORTS_MAC80211
	default y
	help
	  This option enables the 'minstrel' TX rate control algorithm
	  for devices that do not have rate control in hardware/firmware.

config BACKPORTS_MAC80211_MESH
	bool "Enable mac80211 mesh networking support"
	depends on BACKPORTS_MAC80211
	help
	  Select this option to enable 802.11 mesh operation in mac80211
	  drivers that support it. 802.11 mesh networks allow devices to
	  communicate directly with each other without requiring a central
	  access point.

config BACKPORTS_MAC80211_LEDS
	bool "Enable LED triggers"
	depends on BACKPORTS_MAC80211 && LEDS_CLASS
	help
	  This option enables a few LED triggers for different
	  packet receive/transmit events.

config BACKPORTS_MAC80211_DEBUGFS
	bool "Export mac80211 internals in DebugFS"
	depends on BACKPORTS_MAC80211 && DEBUG_FS
	help
	  Select this to see extensive information about
	  the internal state of mac80211 in debugfs.

config BACKPORTS_MONITOR_MODE
	bool "Enable monitor mode support"
	depends on BACKPORTS_MAC80211 && PACKET
	help
	  Enable monitor mode for packet capture and injection.
	  Monitor mode allows wireless interfaces to capture all
	  packets on a wireless channel, regardless of destination.

	  This is required for:
	  - Wireless security testing and analysis
	  - Network troubleshooting and debugging
	  - Protocol analysis and research
	  - Frame injection capabilities

	  Monitor mode requires CONFIG_PACKET to be enabled for
	  packet socket support.

	  Say Y to enable monitor mode support.

	  If unsure, say N.

config BACKPORTS_MONITOR_RADIOTAP
	bool "Enable radiotap header support in monitor mode"
	depends on BACKPORTS_MONITOR_MODE
	default y
	help
	  Enable radiotap header support for monitor mode interfaces.
	  Radiotap headers provide detailed information about captured
	  packets including signal strength, data rates, channel
	  information, and other radio metadata.

	  This is essential for:
	  - Detailed wireless analysis
	  - Signal strength monitoring
	  - Channel utilization analysis
	  - Advanced packet inspection

	  Radiotap support is required by most wireless analysis tools
	  including Wireshark, tcpdump, and aircrack-ng.

	  Say Y to enable radiotap header support.

config BACKPORTS_MONITOR_COOKED
	bool "Enable cooked monitor mode support"
	depends on BACKPORTS_MONITOR_MODE
	help
	  Enable cooked monitor mode which provides a simplified
	  interface for packet capture without requiring raw 802.11
	  frame handling.

	  Cooked mode:
	  - Simplifies packet capture for basic monitoring
	  - Provides Ethernet-like headers for easier processing
	  - Reduces complexity for simple monitoring applications
	  - Compatible with standard packet capture libraries

	  This is useful for applications that need basic packet
	  monitoring without the complexity of raw 802.11 frames.

	  Say Y to enable cooked monitor mode support.

config BACKPORTS_MONITOR_CHANNEL_SWITCH
	bool "Enable monitor mode channel switching"
	depends on BACKPORTS_MONITOR_MODE
	default y
	help
	  Enable dynamic channel switching for monitor mode interfaces.
	  This allows monitor interfaces to change channels programmatically
	  for channel scanning and multi-channel monitoring.

	  Features include:
	  - Runtime channel switching via nl80211
	  - Support for channel scanning applications
	  - Multi-channel monitoring capabilities
	  - Integration with frequency hopping tools

	  This is required for:
	  - Wireless site surveys
	  - Multi-channel packet capture
	  - Spectrum analysis tools
	  - Advanced wireless monitoring

	  Say Y to enable monitor mode channel switching.

config BACKPORTS_MONITOR_TX_STATUS
	bool "Enable monitor mode TX status reporting"
	depends on BACKPORTS_MONITOR_MODE
	help
	  Enable transmission status reporting for monitor mode
	  frame injection. This provides feedback about whether
	  injected frames were successfully transmitted.

	  TX status reporting provides:
	  - Confirmation of successful frame transmission
	  - Retry count information
	  - Acknowledgment status
	  - Transmission timing information

	  This is useful for:
	  - Frame injection testing and validation
	  - Wireless protocol testing
	  - Performance analysis of injected frames
	  - Debugging frame injection issues

	  Say Y to enable TX status reporting for monitor mode.

config BACKPORTS_MONITOR_ENHANCED
	bool "Enable enhanced monitor mode capabilities"
	depends on BACKPORTS_MONITOR_MODE
	help
	  Enable enhanced monitor mode capabilities including advanced
	  packet filtering, multi-channel monitoring, and enhanced
	  radiotap header support.

	  Enhanced capabilities include:
	  - Advanced packet filtering and classification
	  - Multi-channel monitoring and scanning
	  - Enhanced radiotap headers with timing information
	  - Hardware timestamping support
	  - Channel quality measurement
	  - Interference detection and analysis

	  This provides advanced monitoring capabilities for security
	  analysis, network troubleshooting, and research applications.

	  Say Y to enable enhanced monitor mode capabilities.

config BACKPORTS_FRAME_INJECTION
	bool "Enable frame injection support"
	depends on BACKPORTS_MONITOR_MODE && PACKET_MMAP
	help
	  Enable raw 802.11 frame injection capabilities.
	  This allows applications to transmit custom 802.11 frames
	  directly through the wireless interface.

	  *** SECURITY WARNING ***
	  Frame injection can be used for wireless attacks and
	  security testing. This feature should only be enabled
	  in controlled environments with proper security measures.

	  Frame injection requires CONFIG_PACKET_MMAP for efficient
	  packet transmission and memory mapping support.

	  Frame injection is used for:
	  - Wireless penetration testing
	  - Protocol compliance testing
	  - Research and development
	  - Network security auditing

	  Only enable this if you understand the security implications
	  and have implemented appropriate access controls.

	  Say Y to enable frame injection support.

	  If unsure, say N.

config BACKPORTS_INJECTION_RATE_CONTROL
	bool "Enable rate control for injected frames"
	depends on BACKPORTS_FRAME_INJECTION
	default y
	help
	  Enable rate control and retry logic for injected frames.
	  This provides automatic rate adaptation and retry handling
	  for frames transmitted via frame injection.

	  Features include:
	  - Automatic rate selection based on channel conditions
	  - Retry logic for failed transmissions
	  - Rate fallback on transmission failures
	  - Integration with hardware rate control

	  This improves the reliability of injected frames and
	  provides better integration with the wireless stack.

	  Say Y to enable rate control for injected frames.

config BACKPORTS_INJECTION_SEQUENCE_CONTROL
	bool "Enable sequence number control for injected frames"
	depends on BACKPORTS_FRAME_INJECTION
	help
	  Enable automatic sequence number management for injected
	  frames. This ensures proper sequence numbering for frames
	  that require it and prevents sequence number conflicts.

	  Features include:
	  - Automatic sequence number assignment
	  - Per-destination sequence tracking
	  - Duplicate detection and prevention
	  - Integration with existing sequence management

	  This is important for:
	  - Protocol compliance testing
	  - Proper frame ordering
	  - Avoiding sequence number conflicts
	  - Integration with existing connections

	  Say Y to enable sequence number control.

config BACKPORTS_INJECTION_POWER_CONTROL
	bool "Enable power control for injected frames"
	depends on BACKPORTS_FRAME_INJECTION
	help
	  Enable transmission power control for injected frames.
	  This allows fine-grained control over the transmission
	  power of individual injected frames.

	  Features include:
	  - Per-frame power level control
	  - Integration with regulatory power limits
	  - Support for power ramping and testing
	  - Compliance with local regulations

	  This is useful for:
	  - Range testing and validation
	  - Power consumption optimization
	  - Regulatory compliance testing
	  - Signal strength analysis

	  Say Y to enable power control for injected frames.

config BACKPORTS_INJECTION_TIMING_CONTROL
	bool "Enable precise timing control for injected frames"
	depends on BACKPORTS_FRAME_INJECTION
	help
	  Enable precise timing control for frame injection.
	  This provides microsecond-level timing control for
	  transmitted frames and inter-frame spacing.

	  Features include:
	  - Precise transmission timing
	  - Inter-frame gap control
	  - Burst transmission support
	  - Hardware timestamp integration

	  This is essential for:
	  - Protocol timing testing
	  - Performance analysis
	  - Interference testing
	  - Real-time applications

	  Say Y to enable precise timing control.

