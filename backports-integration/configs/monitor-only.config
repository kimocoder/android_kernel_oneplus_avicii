#
# Monitor Mode Only Configuration Template
#
# This configuration enables only monitor mode capabilities for passive
# wireless monitoring and packet capture. No transmission capabilities
# are enabled, making it suitable for monitoring applications.
#
# *** REGULATORY NOTE ***
# Monitor mode may require authorization in some jurisdictions.
# Ensure compliance with local regulations before use.
#

# Core backports configuration
CONFIG_BACKPORTS=y
CONFIG_BACKPORTS_VERSION="6.1"
CONFIG_BACKPORTS_KERNEL_COMPAT=y

# Wireless stack components
CONFIG_BACKPORTS_CFG80211=m
CONFIG_BACKPORTS_MAC80211=m
CONFIG_BACKPORTS_MAC80211_RC_MINSTREL=y
CONFIG_BACKPORTS_MAC80211_LEDS=y
CONFIG_BACKPORTS_MAC80211_DEBUGFS=y

# Wireless drivers
CONFIG_BACKPORTS_WIRELESS_DRIVERS=y
CONFIG_BACKPORTS_WIRELESS_REGULATORY=y
CONFIG_BACKPORTS_WIRELESS_CRYPTO=y

# Qualcomm Atheros drivers (excellent for monitoring)
CONFIG_BACKPORTS_ATH_DRIVERS=y
CONFIG_BACKPORTS_ATH11K=m
CONFIG_BACKPORTS_ATH11K_QCA6390=y
CONFIG_BACKPORTS_ATH11K_QCA6490=y
CONFIG_BACKPORTS_ATH11K_WCN6855=y
CONFIG_BACKPORTS_ATH11K_QCN9074=y
CONFIG_BACKPORTS_ATH11K_DEBUGFS=y
CONFIG_BACKPORTS_ATH11K_SPECTRAL=y

CONFIG_BACKPORTS_ATH10K=m
CONFIG_BACKPORTS_ATH10K_DEBUGFS=y
CONFIG_BACKPORTS_ATH10K_SPECTRAL=y

CONFIG_BACKPORTS_ATH9K=m
CONFIG_BACKPORTS_ATH9K_DEBUGFS=y

# Ralink/MediaTek drivers
CONFIG_BACKPORTS_RT2X00=m
CONFIG_BACKPORTS_RT2X00_DEBUGFS=y

# Monitor mode enabled (read-only)
CONFIG_BACKPORTS_MONITOR_MODE=y
CONFIG_BACKPORTS_MONITOR_RADIOTAP=y
CONFIG_BACKPORTS_MONITOR_CHANNEL_SWITCH=y
CONFIG_BACKPORTS_MONITOR_TX_STATUS=y
CONFIG_BACKPORTS_WIRELESS_MONITOR_ENHANCED=y

# NO frame injection (monitor only)
# CONFIG_BACKPORTS_FRAME_INJECTION is not set
# CONFIG_BACKPORTS_INJECTION_RATE_CONTROL is not set
# CONFIG_BACKPORTS_INJECTION_SEQUENCE_CONTROL is not set

# Standard power management
CONFIG_BACKPORTS_POWER_MANAGEMENT=y

# Regulatory compliance (important for monitor mode)
CONFIG_BACKPORTS_REGULATORY_ENFORCEMENT=y

# Statistics and monitoring
CONFIG_BACKPORTS_STATISTICS=y

# Debugging for monitoring applications
CONFIG_BACKPORTS_DEBUG=y
CONFIG_BACKPORTS_DIAGNOSTICS=y

# Required kernel features for monitoring
CONFIG_MODULES=y
CONFIG_NET=y
CONFIG_PACKET=y
CONFIG_PACKET_MMAP=y
CONFIG_RFKILL=y
CONFIG_CRYPTO=y
CONFIG_CRYPTO_ARC4=y
CONFIG_CRYPTO_AES=y
CONFIG_CRYPTO_CMAC=y
CONFIG_CRYPTO_CCMP=y
CONFIG_CRYPTO_GCMP=y
CONFIG_CRC32=y

# Debugging and tracing support
CONFIG_DEBUG_FS=y
CONFIG_TRACING=y

# Network packet capture
CONFIG_TUN=y

# Disable conflicting options
# CONFIG_CFG80211 is not set
# CONFIG_MAC80211 is not set
# CONFIG_ATH11K is not set
# CONFIG_ATH10K is not set
# CONFIG_ATH9K is not set
# CONFIG_RT2X00 is not set

# Disable vendor drivers
# CONFIG_QCACLD is not set
# CONFIG_PRIMA_WLAN is not set
# CONFIG_WCNSS_CORE is not set
# CONFIG_BCMDHD is not set