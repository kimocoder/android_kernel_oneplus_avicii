#
# Advanced Security Research Configuration Template
#
# This configuration is designed for advanced wireless security research,
# penetration testing, and wireless protocol analysis. It includes all
# security research features with comprehensive monitoring capabilities.
#
# *** SECURITY WARNING ***
# This configuration enables monitor mode, packet injection, and other
# security-sensitive features. Only use in isolated test environments
# with proper security controls and legal authorization.
#
# *** REGULATORY WARNING ***
# Monitor mode and packet injection may be restricted or prohibited
# in your jurisdiction. Ensure compliance with local regulations.
#

# Core backports configuration
CONFIG_BACKPORTS=y
CONFIG_BACKPORTS_VERSION="6.1"
CONFIG_BACKPORTS_KERNEL_COMPAT=y

# Wireless stack components with full debugging
CONFIG_BACKPORTS_CFG80211=m
CONFIG_BACKPORTS_MAC80211=m
CONFIG_BACKPORTS_MAC80211_RC_MINSTREL=y
CONFIG_BACKPORTS_MAC80211_LEDS=y
CONFIG_BACKPORTS_MAC80211_DEBUGFS=y
CONFIG_BACKPORTS_MAC80211_MESH=y

# Wireless drivers optimized for research
CONFIG_BACKPORTS_WIRELESS_DRIVERS=y
CONFIG_BACKPORTS_WIRELESS_REGULATORY=y
CONFIG_BACKPORTS_WIRELESS_CRYPTO=y

# Qualcomm Atheros drivers (excellent for research)
CONFIG_BACKPORTS_ATH_DRIVERS=y
CONFIG_BACKPORTS_ATH11K=m
CONFIG_BACKPORTS_ATH11K_QCA6390=y
CONFIG_BACKPORTS_ATH11K_QCA6490=y
CONFIG_BACKPORTS_ATH11K_WCN6855=y
CONFIG_BACKPORTS_ATH11K_QCN9074=y
CONFIG_BACKPORTS_ATH11K_DEBUG=y
CONFIG_BACKPORTS_ATH11K_DEBUGFS=y
CONFIG_BACKPORTS_ATH11K_SPECTRAL=y
CONFIG_BACKPORTS_ATH11K_TRACING=y

CONFIG_BACKPORTS_ATH10K=m
CONFIG_BACKPORTS_ATH10K_DEBUG=y
CONFIG_BACKPORTS_ATH10K_DEBUGFS=y
CONFIG_BACKPORTS_ATH10K_SPECTRAL=y
CONFIG_BACKPORTS_ATH10K_TRACING=y

CONFIG_BACKPORTS_ATH9K=m
CONFIG_BACKPORTS_ATH9K_DEBUG=y
CONFIG_BACKPORTS_ATH9K_DEBUGFS=y

# Ralink/MediaTek drivers (good for USB research)
CONFIG_BACKPORTS_RT2X00=m
CONFIG_BACKPORTS_RT2X00_DEBUG=y
CONFIG_BACKPORTS_RT2X00_DEBUGFS=y

# Realtek RTW88 drivers (excellent for USB research)
CONFIG_BACKPORTS_RTW88=m
CONFIG_BACKPORTS_RTW88_CORE=m
CONFIG_BACKPORTS_RTW88_USB=m
CONFIG_BACKPORTS_RTW88_8822B=m
CONFIG_BACKPORTS_RTW88_8822C=m
CONFIG_BACKPORTS_RTW88_8821C=m
CONFIG_BACKPORTS_RTW88_8723D=m
CONFIG_BACKPORTS_RTW88_DEBUG=y
CONFIG_BACKPORTS_RTW88_DEBUGFS=y

# MediaTek MT76 drivers (modern USB with Wi-Fi 6)
CONFIG_BACKPORTS_MT76=m
CONFIG_BACKPORTS_MT76_CORE=m
CONFIG_BACKPORTS_MT76_USB=m
CONFIG_BACKPORTS_MT7601U=m
CONFIG_BACKPORTS_MT7610U=m
CONFIG_BACKPORTS_MT7612U=m
CONFIG_BACKPORTS_MT7663U=m
CONFIG_BACKPORTS_MT7921U=m
CONFIG_BACKPORTS_MT76_DEBUG=y
CONFIG_BACKPORTS_MT76_DEBUGFS=y

# Monitor mode with advanced features
CONFIG_BACKPORTS_MONITOR_MODE=y
CONFIG_BACKPORTS_MONITOR_RADIOTAP=y
CONFIG_BACKPORTS_MONITOR_CHANNEL_SWITCH=y
CONFIG_BACKPORTS_MONITOR_TX_STATUS=y
CONFIG_BACKPORTS_WIRELESS_MONITOR_ENHANCED=y

# Frame injection with full control
CONFIG_BACKPORTS_FRAME_INJECTION=y
CONFIG_BACKPORTS_INJECTION_RATE_CONTROL=y
CONFIG_BACKPORTS_INJECTION_SEQUENCE_CONTROL=y
CONFIG_BACKPORTS_INJECTION_POWER_CONTROL=y
CONFIG_BACKPORTS_INJECTION_TIMING_CONTROL=y
CONFIG_BACKPORTS_WIRELESS_INJECTION_ENHANCED=y

# Security auditing and monitoring
CONFIG_BACKPORTS_INJECTION_SECURITY_AUDIT=y
CONFIG_BACKPORTS_STATISTICS=y
CONFIG_BACKPORTS_SECURITY_MONITOR=y

# Mesh networking for research
CONFIG_BACKPORTS_WIRELESS_MESH=y
CONFIG_BACKPORTS_WIRELESS_MESH_ENHANCED=y

# Regulatory compliance (can be relaxed for research)
CONFIG_BACKPORTS_REGULATORY_ENFORCEMENT=y

# Full debugging and diagnostics
CONFIG_BACKPORTS_DEBUG=y
CONFIG_BACKPORTS_DEBUG_INJECTION=y
CONFIG_BACKPORTS_DIAGNOSTICS=y
CONFIG_BACKPORTS_TRACING=y

# Required kernel features for security research
CONFIG_MODULES=y
CONFIG_NET=y
CONFIG_PACKET=y
CONFIG_PACKET_MMAP=y
CONFIG_RFKILL=y
CONFIG_CRYPTO=y
CONFIG_CRYPTO_ARC4=y
CONFIG_CRYPTO_AES=y
CONFIG_CRYPTO_CMAC=y
CONFIG_CRYPTO_CCMP=y
CONFIG_CRYPTO_GCMP=y
CONFIG_CRC32=y

# Security and auditing
CONFIG_AUDIT=y
CONFIG_AUDITSYSCALL=y
CONFIG_SECURITY=y
CONFIG_SECURITY_NETWORK=y
CONFIG_NET_NS=y
CONFIG_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y

# Debugging and tracing support
CONFIG_DEBUG_FS=y
CONFIG_TRACING=y
CONFIG_FTRACE=y
CONFIG_DYNAMIC_DEBUG=y

# Network packet capture
CONFIG_TUN=y
CONFIG_BRIDGE=y
CONFIG_VLAN_8021Q=y

# Disable conflicting options
# CONFIG_CFG80211 is not set
# CONFIG_MAC80211 is not set
# CONFIG_ATH11K is not set
# CONFIG_ATH10K is not set
# CONFIG_ATH9K is not set
# CONFIG_IWLWIFI is not set
# CONFIG_RT2X00 is not set

# Disable vendor drivers that may conflict
# CONFIG_QCACLD is not set
# CONFIG_PRIMA_WLAN is not set
# CONFIG_WCNSS_CORE is not set
# CONFIG_BCMDHD is not set