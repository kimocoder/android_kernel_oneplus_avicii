#
# Android Mobile Configuration Template
#
# This configuration is optimized for Android mobile devices with
# power efficiency, Android framework integration, and mobile-specific
# optimizations. Designed for Android kernel 4.19 and newer.
#

# Core backports configuration with Android support
CONFIG_BACKPORTS=y
CONFIG_BACKPORTS_VERSION="6.1"
CONFIG_BACKPORTS_KERNEL_COMPAT=y
CONFIG_BACKPORTS_ANDROID_COMPAT=y
CONFIG_BACKPORTS_MOBILE_PLATFORM_COMPAT=y

# Android-specific features
CONFIG_BACKPORTS_ANDROID=y
CONFIG_BACKPORTS_ANDROID_POWER=y
CONFIG_BACKPORTS_ANDROID_WAKELOCK=y
CONFIG_BACKPORTS_ANDROID_PROPERTY=y
CONFIG_BACKPORTS_SECURITY_ANDROID=y

# Wireless stack components
CONFIG_BACKPORTS_CFG80211=m
CONFIG_BACKPORTS_MAC80211=m
CONFIG_BACKPORTS_MAC80211_RC_MINSTREL=y
CONFIG_BACKPORTS_MAC80211_LEDS=y

# Wireless drivers for mobile
CONFIG_BACKPORTS_WIRELESS_DRIVERS=y
CONFIG_BACKPORTS_WIRELESS_REGULATORY=y
CONFIG_BACKPORTS_WIRELESS_CRYPTO=y

# Qualcomm Atheros drivers (common in mobile)
CONFIG_BACKPORTS_ATH_DRIVERS=y
CONFIG_BACKPORTS_ATH11K=m
CONFIG_BACKPORTS_ATH11K_QCA6390=y
CONFIG_BACKPORTS_ATH11K_QCA6490=y
CONFIG_BACKPORTS_ATH11K_WCN6855=y

CONFIG_BACKPORTS_ATH10K=m

# Vendor driver compatibility
CONFIG_BACKPORTS_VENDOR_COMPAT=y
CONFIG_BACKPORTS_VENDOR_QCOM=y

# No monitor mode or injection (Android security policy)
# CONFIG_BACKPORTS_MONITOR_MODE is not set
# CONFIG_BACKPORTS_FRAME_INJECTION is not set

# Mobile power management
CONFIG_BACKPORTS_POWER_MANAGEMENT=y
CONFIG_BACKPORTS_POWER_COMPAT=y
CONFIG_BACKPORTS_MOBILE_POWER_SAVE=y
CONFIG_BACKPORTS_BATTERY_OPTIMIZATION=y

# Android security integration
CONFIG_BACKPORTS_SELINUX_ANDROID=y
CONFIG_BACKPORTS_ANDROID_PERMISSIONS=y

# Regulatory compliance for mobile
CONFIG_BACKPORTS_REGULATORY_ENFORCEMENT=y

# Minimal debugging for production mobile
# CONFIG_BACKPORTS_DEBUG is not set

# Required kernel features for Android
CONFIG_MODULES=y
CONFIG_NET=y
CONFIG_RFKILL=y
CONFIG_CRYPTO=y
CONFIG_CRYPTO_ARC4=y
CONFIG_CRYPTO_AES=y
CONFIG_CRYPTO_CMAC=y
CONFIG_CRYPTO_CCMP=y
CONFIG_CRYPTO_GCMP=y
CONFIG_CRC32=y

# Android-specific kernel features
CONFIG_ANDROID=y
CONFIG_ANDROID_BINDER_IPC=y
CONFIG_ASHMEM=y
CONFIG_ANDROID_LOW_MEMORY_KILLER=y
CONFIG_ANDROID_INTF_ALARM_DEV=y

# Power management for mobile
CONFIG_PM=y
CONFIG_PM_RUNTIME=y
CONFIG_PM_SLEEP=y
CONFIG_PM_AUTOSLEEP=y
CONFIG_PM_WAKELOCKS=y
CONFIG_SUSPEND=y
CONFIG_HIBERNATION=y

# Android security
CONFIG_SECURITY=y
CONFIG_SECURITY_SELINUX=y
CONFIG_SECURITY_SELINUX_BOOTPARAM=y
CONFIG_SECURITY_SELINUX_DEVELOP=y
CONFIG_SECURITY_SELINUX_AVC_STATS=y
CONFIG_ANDROID_PARANOID_NETWORK=y

# Mobile networking
CONFIG_NET_NS=y
CONFIG_NETFILTER=y
CONFIG_NETFILTER_NETLINK=y
CONFIG_NF_CONNTRACK=y
CONFIG_NETFILTER_XT_TARGET_MARK=y

# Memory management for mobile
CONFIG_ZRAM=y
CONFIG_ZSMALLOC=y
CONFIG_MEMCG=y
CONFIG_MEMCG_SWAP=y

# File systems for Android
CONFIG_EXT4_FS=y
CONFIG_F2FS_FS=y
CONFIG_FUSE_FS=y
CONFIG_SDCARD_FS=y

# Disable conflicting options
# CONFIG_CFG80211 is not set
# CONFIG_MAC80211 is not set
# CONFIG_ATH11K is not set
# CONFIG_ATH10K is not set

# Disable conflicting vendor drivers
# CONFIG_QCACLD is not set
# CONFIG_PRIMA_WLAN is not set
# CONFIG_WCNSS_CORE is not set