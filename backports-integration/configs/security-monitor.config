#
# Security and Monitor Mode Configuration
# Comprehensive setup for wireless security analysis and monitoring
#

# Core wireless stack with security enhancements
CONFIG_BACKPORTS=y
CONFIG_BACKPORTS_WIRELESS_DRIVERS=y
CONFIG_BACKPORTS_CFG80211=m
CONFIG_BACKPORTS_MAC80211=m
CONFIG_BACKPORTS_WIRELESS_REGULATORY=y

# Monitor mode capabilities
CONFIG_BACKPORTS_MONITOR_MODE=y
CONFIG_BACKPORTS_MONITOR_RADIOTAP=y
CONFIG_BACKPORTS_MONITOR_COOKED=y
CONFIG_BACKPORTS_MONITOR_TX_STATUS=y
CONFIG_BACKPORTS_MONITOR_CHANNEL_SWITCH=y
CONFIG_BACKPORTS_MONITOR_ENHANCED=y

# Packet injection capabilities
CONFIG_BACKPORTS_FRAME_INJECTION=y
CONFIG_BACKPORTS_INJECTION_RATE_CONTROL=y
CONFIG_BACKPORTS_INJECTION_POWER_CONTROL=y
CONFIG_BACKPORTS_INJECTION_SEQUENCE_CONTROL=y
CONFIG_BACKPORTS_INJECTION_TIMESTAMP=y
CONFIG_BACKPORTS_INJECTION_ENHANCED=y

# Security and analysis features
CONFIG_BACKPORTS_WIRELESS_SECURITY_ENHANCED=y
CONFIG_BACKPORTS_WIRELESS_ANALYSIS=y
CONFIG_BACKPORTS_WIRELESS_FORENSICS=y
CONFIG_BACKPORTS_REGULATORY_COMPLIANCE=y
CONFIG_BACKPORTS_SECURITY_WARNINGS=y

# Radiotap enhancements
CONFIG_BACKPORTS_RADIOTAP_ENHANCED=y
CONFIG_BACKPORTS_RADIOTAP_VENDOR=y
CONFIG_BACKPORTS_RADIOTAP_MCS=y
CONFIG_BACKPORTS_RADIOTAP_VHT=y
CONFIG_BACKPORTS_RADIOTAP_HE=y
CONFIG_BACKPORTS_RADIOTAP_TIMESTAMP=y
CONFIG_BACKPORTS_RADIOTAP_FLAGS_EXTENDED=y

# Channel switching and scanning
CONFIG_BACKPORTS_CHANNEL_SWITCH_ENHANCED=y
CONFIG_BACKPORTS_CHANNEL_SCAN_PASSIVE=y
CONFIG_BACKPORTS_CHANNEL_SCAN_ACTIVE=y
CONFIG_BACKPORTS_FREQUENCY_HOPPING=y
CONFIG_BACKPORTS_CHANNEL_SURVEY=y

# Driver-specific monitor enhancements
CONFIG_BACKPORTS_ATH10K_MONITOR_ENHANCED=y
CONFIG_BACKPORTS_ATH11K_MONITOR_ENHANCED=y
CONFIG_BACKPORTS_RT2X00_MONITOR_ENHANCED=y
CONFIG_BACKPORTS_IWLWIFI_MONITOR_ENHANCED=y

# Spectral scanning (where supported)
CONFIG_BACKPORTS_SPECTRAL_SCAN=y
CONFIG_BACKPORTS_ATH_SPECTRAL_ENHANCED=y
CONFIG_BACKPORTS_ATH10K_SPECTRAL_SCAN=y
CONFIG_BACKPORTS_ATH11K_SPECTRAL_SCAN=y

# Security monitoring features
CONFIG_BACKPORTS_SECURITY_MONITOR=y
CONFIG_BACKPORTS_DEAUTH_DETECTION=y
CONFIG_BACKPORTS_BEACON_ANALYSIS=y
CONFIG_BACKPORTS_PROBE_ANALYSIS=y
CONFIG_BACKPORTS_EAPOL_MONITORING=y
CONFIG_BACKPORTS_WPS_DETECTION=y

# Packet filtering and analysis
CONFIG_BACKPORTS_PACKET_FILTER=y
CONFIG_BACKPORTS_FRAME_CLASSIFIER=y
CONFIG_BACKPORTS_PROTOCOL_ANALYZER=y
CONFIG_BACKPORTS_TRAFFIC_ANALYZER=y

# Rate control for injection
CONFIG_BACKPORTS_RATE_CONTROL_ENHANCED=y
CONFIG_BACKPORTS_MINSTREL_ENHANCED=y
CONFIG_BACKPORTS_RATE_CONTROL_DEBUG=y

# Power control for injection
CONFIG_BACKPORTS_POWER_CONTROL_ENHANCED=y
CONFIG_BACKPORTS_TX_POWER_CONTROL=y
CONFIG_BACKPORTS_REGULATORY_POWER_LIMITS=y

# Timing and synchronization
CONFIG_BACKPORTS_TIMING_ENHANCED=y
CONFIG_BACKPORTS_TSF_SYNC=y
CONFIG_BACKPORTS_BEACON_TIMING=y
CONFIG_BACKPORTS_TIMESTAMP_CORRECTION=y

# Mesh networking for security analysis
CONFIG_BACKPORTS_MAC80211_MESH=y
CONFIG_BACKPORTS_WIRELESS_MESH_ENHANCED=y
CONFIG_BACKPORTS_MESH_SECURITY=y
CONFIG_BACKPORTS_MESH_MONITORING=y

# Cryptographic support for analysis
CONFIG_BACKPORTS_WIRELESS_CRYPTO=y
CONFIG_CRYPTO=y
CONFIG_CRYPTO_ARC4=y
CONFIG_CRYPTO_ECB=y
CONFIG_CRYPTO_AES=y
CONFIG_CRYPTO_CMAC=y
CONFIG_CRYPTO_CCMP=y
CONFIG_CRYPTO_GCMP=y
CONFIG_CRYPTO_SHA1=y
CONFIG_CRYPTO_SHA256=y
CONFIG_CRYPTO_MICHAEL_MIC=y

# WPA/WPA2/WPA3 analysis
CONFIG_BACKPORTS_WPA_ANALYSIS=y
CONFIG_BACKPORTS_WPA2_ANALYSIS=y
CONFIG_BACKPORTS_WPA3_ANALYSIS=y
CONFIG_BACKPORTS_SAE_MONITORING=y
CONFIG_BACKPORTS_OWE_MONITORING=y

# Regulatory compliance and warnings
CONFIG_BACKPORTS_REGULATORY_ENHANCED=y
CONFIG_BACKPORTS_REGULATORY_WARNINGS=y
CONFIG_BACKPORTS_COUNTRY_CODE_VALIDATION=y
CONFIG_BACKPORTS_DFS_COMPLIANCE=y
CONFIG_BACKPORTS_POWER_LIMIT_ENFORCEMENT=y

# Debugging and diagnostics
CONFIG_BACKPORTS_MONITOR_DEBUG=y
CONFIG_BACKPORTS_INJECTION_DEBUG=y
CONFIG_BACKPORTS_SECURITY_DEBUG=y
CONFIG_BACKPORTS_REGULATORY_DEBUG=y
CONFIG_BACKPORTS_RADIOTAP_DEBUG=y

# Statistics and reporting
CONFIG_BACKPORTS_STATISTICS_ENHANCED=y
CONFIG_BACKPORTS_PACKET_STATISTICS=y
CONFIG_BACKPORTS_SECURITY_STATISTICS=y
CONFIG_BACKPORTS_CHANNEL_STATISTICS=y
CONFIG_BACKPORTS_PERFORMANCE_MONITORING=y

# Advanced features
CONFIG_BACKPORTS_WIRELESS_EXT_SYSFS=y
CONFIG_BACKPORTS_LIB80211=y
CONFIG_BACKPORTS_LIB80211_CRYPT_WEP=y
CONFIG_BACKPORTS_LIB80211_CRYPT_CCMP=y
CONFIG_BACKPORTS_LIB80211_CRYPT_TKIP=y
CONFIG_BACKPORTS_LIB80211_DEBUG=y

# Network namespace support for isolation
CONFIG_NET_NS=y
CONFIG_BACKPORTS_WIRELESS_NET_NS=y
CONFIG_BACKPORTS_MONITOR_NET_NS=y

# Quality of Service for analysis
CONFIG_BACKPORTS_MAC80211_QOS=y
CONFIG_BACKPORTS_MAC80211_HT=y
CONFIG_BACKPORTS_MAC80211_VHT=y
CONFIG_BACKPORTS_MAC80211_HE=y

# LED support for status indication
CONFIG_BACKPORTS_LEDS_CLASS=y
CONFIG_BACKPORTS_LEDS_TRIGGERS=y
CONFIG_BACKPORTS_LEDS_TRIGGER_WIFI=y
CONFIG_BACKPORTS_LEDS_MONITOR_STATUS=y

# Firmware loading with security validation
CONFIG_BACKPORTS_FW_LOADER=y
CONFIG_BACKPORTS_FW_LOADER_USER_HELPER=y
CONFIG_BACKPORTS_FW_LOADER_SECURITY=y
CONFIG_BACKPORTS_FW_SIGNATURE_VALIDATION=y

# USB support for dongles
CONFIG_USB=y
CONFIG_USB_SUPPORT=y

# PCI support for cards
CONFIG_PCI=y
CONFIG_PCI_MSI=y

# SDIO support for embedded
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_SDHCI=y

# Tracing and profiling
CONFIG_BACKPORTS_TRACING_ENHANCED=y
CONFIG_BACKPORTS_FTRACE_WIRELESS=y
CONFIG_BACKPORTS_PERF_EVENTS=y
CONFIG_BACKPORTS_TRACE_PACKETS=y

# Security hardening
CONFIG_BACKPORTS_SECURITY_HARDENING=y
CONFIG_BACKPORTS_BUFFER_OVERFLOW_PROTECTION=y
CONFIG_BACKPORTS_STACK_PROTECTION=y
CONFIG_BACKPORTS_MEMORY_SANITIZER=y