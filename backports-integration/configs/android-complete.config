#
# Complete Android Backports Configuration Template
#
# This configuration provides comprehensive Android integration with
# backports including security model integration, vendor driver
# compatibility, and Android-specific features.
#
# Designed for Android kernel 4.19 with full Android framework integration.
#

# Core backports configuration
CONFIG_BACKPORTS=y
CONFIG_BACKPORTS_VERSION="6.1"

# Wireless stack components
CONFIG_BACKPORTS_CFG80211=m
CONFIG_BACKPORTS_MAC80211=m
CONFIG_BACKPORTS_MAC80211_RC_MINSTREL=y
CONFIG_BACKPORTS_MAC80211_LEDS=y

# Monitor mode (optional for Android)
# CONFIG_BACKPORTS_MONITOR_MODE is not set
# CONFIG_BACKPORTS_FRAME_INJECTION is not set

# Android-specific adaptations
CONFIG_BACKPORTS_ANDROID=y
CONFIG_BACKPORTS_ANDROID_WAKELOCK=y
CONFIG_BACKPORTS_ANDROID_BINDER=y
CONFIG_BACKPORTS_ANDROID_LOGGER=y
CONFIG_BACKPORTS_ANDROID_PARANOID_NETWORK=y
CONFIG_BACKPORTS_ANDROID_LOW_MEMORY_KILLER=y
CONFIG_BACKPORTS_ANDROID_ASHMEM=y
CONFIG_BACKPORTS_ANDROID_PROPERTY=y

# Vendor driver compatibility
CONFIG_BACKPORTS_VENDOR_COMPAT=y
CONFIG_BACKPORTS_VENDOR_QCOM=y
CONFIG_BACKPORTS_VENDOR_QCOM_QCACLD=y
CONFIG_BACKPORTS_VENDOR_QCOM_PRIMA=y
CONFIG_BACKPORTS_VENDOR_QCOM_WCNSS=y
CONFIG_BACKPORTS_VENDOR_CONFLICT_DETECTION=y
CONFIG_BACKPORTS_VENDOR_MIGRATION=y

# Android security integration
CONFIG_BACKPORTS_SECURITY_ANDROID=y
CONFIG_BACKPORTS_SELINUX_ANDROID=y
CONFIG_BACKPORTS_ANDROID_PERMISSIONS=y
CONFIG_BACKPORTS_ANDROID_KEYSTORE=y
CONFIG_BACKPORTS_ANDROID_VERIFIED_BOOT=y
CONFIG_BACKPORTS_ANDROID_SECURITY_PATCH=y
CONFIG_BACKPORTS_ANDROID_DEVICE_ADMIN=y
CONFIG_BACKPORTS_ANDROID_WORK_PROFILE=y
CONFIG_BACKPORTS_ANDROID_SECURITY_AUDIT=y

# Minimal debugging for production
CONFIG_BACKPORTS_DEBUG=y
CONFIG_BACKPORTS_STATISTICS=y

# Required Android kernel features
CONFIG_ANDROID=y
CONFIG_ANDROID_WAKELOCK=y
CONFIG_ANDROID_BINDER_IPC=y
CONFIG_ANDROID_LOGGER=y
CONFIG_ANDROID_PARANOID_NETWORK=y
CONFIG_ANDROID_LOW_MEMORY_KILLER=y
CONFIG_ASHMEM=y
CONFIG_ANDROID_KEYSTORE=y
CONFIG_ANDROID_VERIFIED_BOOT=y

# Required kernel features
CONFIG_MODULES=y
CONFIG_NET=y
CONFIG_RFKILL=y
CONFIG_CRYPTO=y
CONFIG_CRYPTO_ARC4=y
CONFIG_CRYPTO_AES=y
CONFIG_CRC32=y

# Security features
CONFIG_SECURITY=y
CONFIG_SECURITY_SELINUX=y
CONFIG_SECURITY_NETWORK=y
CONFIG_AUDIT=y
CONFIG_AUDITSYSCALL=y

# Power management
CONFIG_PM=y
CONFIG_PM_SLEEP=y
CONFIG_SUSPEND=y

# Memory management
CONFIG_MEMCG=y
CONFIG_MEMCG_SWAP=y

# Disable conflicting options
# CONFIG_CFG80211 is not set
# CONFIG_MAC80211 is not set

# Disable conflicting vendor drivers
# CONFIG_QCACLD is not set
# CONFIG_PRIMA_WLAN is not set
# CONFIG_WCNSS_CORE is not set

# Optional features for enhanced functionality
CONFIG_LEDS_CLASS=y
CONFIG_DEBUG_FS=y