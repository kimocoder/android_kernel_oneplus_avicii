#
# Enterprise Wireless Configuration Template
#
# This configuration is optimized for enterprise wireless deployments
# with advanced security, management features, and enterprise-grade
# reliability. Suitable for corporate networks and managed environments.
#

# Core backports configuration
CONFIG_BACKPORTS=y
CONFIG_BACKPORTS_VERSION="6.1"
CONFIG_BACKPORTS_KERNEL_COMPAT=y

# Wireless stack components
CONFIG_BACKPORTS_CFG80211=m
CONFIG_BACKPORTS_MAC80211=m
CONFIG_BACKPORTS_MAC80211_RC_MINSTREL=y
CONFIG_BACKPORTS_MAC80211_LEDS=y
CONFIG_BACKPORTS_MAC80211_DEBUGFS=y

# Wireless drivers
CONFIG_BACKPORTS_WIRELESS_DRIVERS=y
CONFIG_BACKPORTS_WIRELESS_REGULATORY=y
CONFIG_BACKPORTS_WIRELESS_CRYPTO=y

# Intel wireless drivers (preferred for enterprise)
CONFIG_BACKPORTS_IWLWIFI=m
CONFIG_BACKPORTS_IWLWIFI_DEBUGFS=y

# Qualcomm Atheros drivers
CONFIG_BACKPORTS_ATH_DRIVERS=y
CONFIG_BACKPORTS_ATH11K=m
CONFIG_BACKPORTS_ATH11K_QCA6390=y
CONFIG_BACKPORTS_ATH11K_QCA6490=y
CONFIG_BACKPORTS_ATH11K_WCN6855=y
CONFIG_BACKPORTS_ATH11K_QCN9074=y
CONFIG_BACKPORTS_ATH11K_DEBUGFS=y

CONFIG_BACKPORTS_ATH10K=m
CONFIG_BACKPORTS_ATH10K_DEBUGFS=y

# No monitor mode or injection (security policy)
# CONFIG_BACKPORTS_MONITOR_MODE is not set
# CONFIG_BACKPORTS_FRAME_INJECTION is not set

# Enterprise power management
CONFIG_BACKPORTS_POWER_MANAGEMENT=y
CONFIG_BACKPORTS_POWER_SAVE=y
CONFIG_BACKPORTS_ENTERPRISE_POWER_POLICY=y

# Enhanced security features
CONFIG_BACKPORTS_WIRELESS_SECURITY_ENHANCED=y
CONFIG_BACKPORTS_ENTERPRISE_SECURITY=y
CONFIG_BACKPORTS_WPA3_ENTERPRISE=y
CONFIG_BACKPORTS_802_1X=y

# Strict regulatory compliance
CONFIG_BACKPORTS_REGULATORY_ENFORCEMENT=y
CONFIG_BACKPORTS_ENTERPRISE_COMPLIANCE=y

# Management and monitoring
CONFIG_BACKPORTS_STATISTICS=y
CONFIG_BACKPORTS_ENTERPRISE_MONITORING=y
CONFIG_BACKPORTS_SNMP_SUPPORT=y

# Minimal debugging for production
# CONFIG_BACKPORTS_DEBUG is not set

# Required kernel features for enterprise
CONFIG_MODULES=y
CONFIG_NET=y
CONFIG_RFKILL=y
CONFIG_CRYPTO=y
CONFIG_CRYPTO_ARC4=y
CONFIG_CRYPTO_AES=y
CONFIG_CRYPTO_CMAC=y
CONFIG_CRYPTO_CCMP=y
CONFIG_CRYPTO_GCMP=y
CONFIG_CRYPTO_SHA1=y
CONFIG_CRYPTO_SHA256=y
CONFIG_CRYPTO_SHA512=y
CONFIG_CRYPTO_MD5=y
CONFIG_CRC32=y

# Enterprise security requirements
CONFIG_SECURITY=y
CONFIG_SECURITY_NETWORK=y
CONFIG_KEYS=y
CONFIG_ENCRYPTED_KEYS=y
CONFIG_TRUSTED_KEYS=y

# Network security
CONFIG_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NETFILTER_NETLINK=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_CONNTRACK_MARK=y
CONFIG_NETFILTER_XT_TARGET_MARK=y
CONFIG_NETFILTER_XT_MATCH_MARK=y

# Quality of Service for enterprise
CONFIG_NET_SCHED=y
CONFIG_NET_SCH_HTB=y
CONFIG_NET_SCH_PRIO=y
CONFIG_NET_SCH_SFQ=y
CONFIG_NET_CLS=y
CONFIG_NET_CLS_BASIC=y
CONFIG_NET_CLS_U32=y
CONFIG_NET_ACT_POLICE=y

# VLAN support for enterprise networks
CONFIG_VLAN_8021Q=y
CONFIG_BRIDGE=y
CONFIG_BRIDGE_VLAN_FILTERING=y

# Power management
CONFIG_PM=y
CONFIG_PM_RUNTIME=y
CONFIG_PM_SLEEP=y

# Auditing for enterprise compliance
CONFIG_AUDIT=y
CONFIG_AUDITSYSCALL=y

# Disable conflicting options
# CONFIG_CFG80211 is not set
# CONFIG_MAC80211 is not set
# CONFIG_ATH11K is not set
# CONFIG_ATH10K is not set
# CONFIG_IWLWIFI is not set

# Disable vendor drivers
# CONFIG_QCACLD is not set
# CONFIG_PRIMA_WLAN is not set
# CONFIG_WCNSS_CORE is not set
# CONFIG_BCMDHD is not set