#
# Embedded IoT Configuration Template
#
# This configuration is optimized for embedded IoT devices with minimal
# resource usage, low power consumption, and essential wireless features.
# Suitable for resource-constrained embedded systems and IoT applications.
#

# Core backports configuration (minimal)
CONFIG_BACKPORTS=y
CONFIG_BACKPORTS_VERSION="6.1"
CONFIG_BACKPORTS_KERNEL_COMPAT=y
CONFIG_BACKPORTS_MOBILE_PLATFORM_COMPAT=y

# Minimal wireless stack
CONFIG_BACKPORTS_CFG80211=m
CONFIG_BACKPORTS_MAC80211=m
CONFIG_BACKPORTS_MAC80211_RC_MINSTREL=y
# CONFIG_BACKPORTS_MAC80211_LEDS is not set
# CONFIG_BACKPORTS_MAC80211_DEBUGFS is not set

# Essential wireless drivers only
CONFIG_BACKPORTS_WIRELESS_DRIVERS=y
CONFIG_BACKPORTS_WIRELESS_REGULATORY=y
CONFIG_BACKPORTS_WIRELESS_CRYPTO=y

# Ralink/MediaTek drivers (common in IoT)
CONFIG_BACKPORTS_RT2X00=m

# Qualcomm Atheros drivers (selected models)
CONFIG_BACKPORTS_ATH_DRIVERS=y
CONFIG_BACKPORTS_ATH10K=m
# CONFIG_BACKPORTS_ATH11K is not set
# CONFIG_BACKPORTS_ATH9K is not set

# No monitor mode or injection (not needed for IoT)
# CONFIG_BACKPORTS_MONITOR_MODE is not set
# CONFIG_BACKPORTS_FRAME_INJECTION is not set

# Aggressive power management for IoT
CONFIG_BACKPORTS_POWER_MANAGEMENT=y
CONFIG_BACKPORTS_POWER_COMPAT=y
CONFIG_BACKPORTS_IOT_POWER_SAVE=y
CONFIG_BACKPORTS_ULTRA_LOW_POWER=y

# Basic security (minimal overhead)
CONFIG_BACKPORTS_WIRELESS_SECURITY_BASIC=y

# Regulatory compliance (basic)
CONFIG_BACKPORTS_REGULATORY_ENFORCEMENT=y

# No debugging (save resources)
# CONFIG_BACKPORTS_DEBUG is not set
# CONFIG_BACKPORTS_STATISTICS is not set
# CONFIG_BACKPORTS_DIAGNOSTICS is not set

# Minimal kernel features for IoT
CONFIG_MODULES=y
CONFIG_NET=y
CONFIG_RFKILL=y
CONFIG_CRYPTO=y
CONFIG_CRYPTO_ARC4=y
CONFIG_CRYPTO_AES=y
CONFIG_CRYPTO_CCMP=y
CONFIG_CRC32=y

# Basic power management
CONFIG_PM=y
CONFIG_PM_RUNTIME=y
CONFIG_PM_SLEEP=y

# Minimal networking
CONFIG_PACKET=y
CONFIG_UNIX=y
CONFIG_INET=y
CONFIG_IPV6=y

# No advanced features to save resources
# CONFIG_NETFILTER is not set
# CONFIG_NET_SCHED is not set
# CONFIG_BRIDGE is not set
# CONFIG_VLAN_8021Q is not set

# Disable all debugging to save resources
# CONFIG_DEBUG_FS is not set
# CONFIG_TRACING is not set
# CONFIG_FTRACE is not set
# CONFIG_DYNAMIC_DEBUG is not set

# Disable conflicting options
# CONFIG_CFG80211 is not set
# CONFIG_MAC80211 is not set
# CONFIG_ATH11K is not set
# CONFIG_ATH10K is not set
# CONFIG_RT2X00 is not set

# Disable vendor drivers
# CONFIG_QCACLD is not set
# CONFIG_PRIMA_WLAN is not set
# CONFIG_WCNSS_CORE is not set
# CONFIG_BCMDHD is not set