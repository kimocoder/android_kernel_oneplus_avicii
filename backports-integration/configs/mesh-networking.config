#
# Mesh Networking Configuration Template
#
# This configuration is optimized for 802.11s mesh networking deployments
# with support for multi-hop routing, mesh security, and advanced mesh
# features. Suitable for IoT, smart city, and distributed networking.
#

# Core backports configuration
CONFIG_BACKPORTS=y
CONFIG_BACKPORTS_VERSION="6.1"
CONFIG_BACKPORTS_KERNEL_COMPAT=y

# Wireless stack components with mesh support
CONFIG_BACKPORTS_CFG80211=m
CONFIG_BACKPORTS_MAC80211=m
CONFIG_BACKPORTS_MAC80211_RC_MINSTREL=y
CONFIG_BACKPORTS_MAC80211_LEDS=y
CONFIG_BACKPORTS_MAC80211_DEBUGFS=y
CONFIG_BACKPORTS_MAC80211_MESH=y

# Wireless drivers
CONFIG_BACKPORTS_WIRELESS_DRIVERS=y
CONFIG_BACKPORTS_WIRELESS_REGULATORY=y
CONFIG_BACKPORTS_WIRELESS_CRYPTO=y

# Mesh networking support
CONFIG_BACKPORTS_WIRELESS_MESH=y
CONFIG_BACKPORTS_WIRELESS_MESH_ENHANCED=y

# Qualcomm Atheros drivers (excellent mesh support)
CONFIG_BACKPORTS_ATH_DRIVERS=y
CONFIG_BACKPORTS_ATH11K=m
CONFIG_BACKPORTS_ATH11K_QCA6390=y
CONFIG_BACKPORTS_ATH11K_QCA6490=y
CONFIG_BACKPORTS_ATH11K_WCN6855=y
CONFIG_BACKPORTS_ATH11K_QCN9074=y
CONFIG_BACKPORTS_ATH11K_DEBUGFS=y

CONFIG_BACKPORTS_ATH10K=m
CONFIG_BACKPORTS_ATH10K_DEBUGFS=y

CONFIG_BACKPORTS_ATH9K=m
CONFIG_BACKPORTS_ATH9K_DEBUGFS=y

# Intel wireless (limited mesh support)
CONFIG_BACKPORTS_IWLWIFI=m

# No monitor mode or injection (not needed for mesh)
# CONFIG_BACKPORTS_MONITOR_MODE is not set
# CONFIG_BACKPORTS_FRAME_INJECTION is not set

# Power management for mesh nodes
CONFIG_BACKPORTS_POWER_MANAGEMENT=y
CONFIG_BACKPORTS_MESH_POWER_SAVE=y

# Enhanced security for mesh networks
CONFIG_BACKPORTS_WIRELESS_SECURITY_ENHANCED=y
CONFIG_BACKPORTS_MESH_SECURITY=y

# Regulatory compliance
CONFIG_BACKPORTS_REGULATORY_ENFORCEMENT=y

# Minimal debugging for production mesh
# CONFIG_BACKPORTS_DEBUG is not set

# Required kernel features for mesh networking
CONFIG_MODULES=y
CONFIG_NET=y
CONFIG_RFKILL=y
CONFIG_CRYPTO=y
CONFIG_CRYPTO_ARC4=y
CONFIG_CRYPTO_AES=y
CONFIG_CRYPTO_CMAC=y
CONFIG_CRYPTO_CCMP=y
CONFIG_CRYPTO_GCMP=y
CONFIG_CRC32=y

# Mesh networking requirements
CONFIG_BRIDGE=y
CONFIG_STP=y
CONFIG_VLAN_8021Q=y
CONFIG_NET_SCHED=y
CONFIG_NET_SCH_HTB=y
CONFIG_NET_SCH_PRIO=y

# Routing and forwarding
CONFIG_IP_ADVANCED_ROUTER=y
CONFIG_IP_MULTIPLE_TABLES=y
CONFIG_IP_ROUTE_MULTIPATH=y
CONFIG_IPV6=y
CONFIG_IPV6_ROUTER_PREF=y
CONFIG_IPV6_ROUTE_INFO=y

# Quality of Service
CONFIG_NET_CLS=y
CONFIG_NET_CLS_BASIC=y
CONFIG_NET_CLS_TCINDEX=y
CONFIG_NET_CLS_U32=y
CONFIG_NET_ACT_POLICE=y
CONFIG_NET_ACT_GACT=y

# Power management for mesh nodes
CONFIG_PM=y
CONFIG_PM_RUNTIME=y

# Disable conflicting options
# CONFIG_CFG80211 is not set
# CONFIG_MAC80211 is not set
# CONFIG_ATH11K is not set
# CONFIG_ATH10K is not set
# CONFIG_ATH9K is not set
# CONFIG_IWLWIFI is not set