#
# Multi-Driver Configuration
# Comprehensive setup for ath10k, iwlwifi, and rt2x00 driver families
#

# Core wireless stack
CONFIG_BACKPORTS=y
CONFIG_BACKPORTS_WIRELESS_DRIVERS=y
CONFIG_BACKPORTS_CFG80211=m
CONFIG_BACKPORTS_MAC80211=m
CONFIG_BACKPORTS_WIRELESS_REGULATORY=y

# Wireless stack features
CONFIG_BACKPORTS_MAC80211_MESH=y
CONFIG_BACKPORTS_MAC80211_DEBUGFS=y
CONFIG_BACKPORTS_CFG80211_DEBUGFS=y
CONFIG_BACKPORTS_WIRELESS_EXT=y
CONFIG_BACKPORTS_WEXT_CORE=y
CONFIG_BACKPORTS_WEXT_PROC=y
CONFIG_BACKPORTS_WEXT_SPY=y
CONFIG_BACKPORTS_WEXT_PRIV=y

# Monitor mode and packet injection
CONFIG_BACKPORTS_MONITOR_MODE=y
CONFIG_BACKPORTS_FRAME_INJECTION=y
CONFIG_BACKPORTS_WIRELESS_MONITOR_ENHANCED=y
CONFIG_BACKPORTS_WIRELESS_INJECTION_ENHANCED=y
CONFIG_BACKPORTS_MONITOR_RADIOTAP=y
CONFIG_BACKPORTS_MONITOR_COOKED=y

# ath10k driver family
CONFIG_BACKPORTS_ATH_DRIVERS=y
CONFIG_BACKPORTS_ATH_DEBUG=y
CONFIG_BACKPORTS_ATH10K=m
CONFIG_BACKPORTS_ATH10K_PCI=m
CONFIG_BACKPORTS_ATH10K_SDIO=m
CONFIG_BACKPORTS_ATH10K_DEBUG=y
CONFIG_BACKPORTS_ATH10K_DEBUGFS=y
CONFIG_BACKPORTS_ATH10K_SPECTRAL=y
CONFIG_BACKPORTS_ATH10K_TRACING=y

# iwlwifi driver family
CONFIG_BACKPORTS_IWLWIFI=m
CONFIG_BACKPORTS_IWLWIFI_DEBUG=y
CONFIG_BACKPORTS_IWLWIFI_DEBUGFS=y
CONFIG_BACKPORTS_IWLWIFI_DEVICE_TRACING=y
CONFIG_BACKPORTS_IWLWIFI_LEDS=y
CONFIG_BACKPORTS_IWLWIFI_OPMODE_MODULAR=y
CONFIG_BACKPORTS_IWLDVM=m
CONFIG_BACKPORTS_IWLMVM=m
CONFIG_BACKPORTS_IWLWIFI_POWER_SAVE=y
CONFIG_BACKPORTS_IWLWIFI_UAPSD=y
CONFIG_BACKPORTS_IWLWIFI_P2P=y

# rt2x00 driver family
CONFIG_BACKPORTS_RT2X00=m
CONFIG_BACKPORTS_RT2X00_LIB=m
CONFIG_BACKPORTS_RT2X00_LIB_DEBUGFS=y
CONFIG_BACKPORTS_RT2X00_LIB_CRYPTO=y
CONFIG_BACKPORTS_RT2X00_LIB_FIRMWARE=y
CONFIG_BACKPORTS_RT2X00_LIB_LEDS=y
CONFIG_BACKPORTS_RT2X00_DEBUG=y

# RT2x00 specific drivers
CONFIG_BACKPORTS_RT2400PCI=m
CONFIG_BACKPORTS_RT2500PCI=m
CONFIG_BACKPORTS_RT61PCI=m
CONFIG_BACKPORTS_RT2500USB=m
CONFIG_BACKPORTS_RT73USB=m
CONFIG_BACKPORTS_RT2800PCI=m
CONFIG_BACKPORTS_RT2800USB=m
CONFIG_BACKPORTS_RT2800SOC=m
CONFIG_BACKPORTS_RT2800_LIB=m
CONFIG_BACKPORTS_RT2800_LIB_MMIO=m

# Mesh networking support
CONFIG_BACKPORTS_WIRELESS_MESH_ENHANCED=y
CONFIG_BACKPORTS_MAC80211_MESH_SYNC_DEBUG=y
CONFIG_BACKPORTS_MAC80211_MESH_CSA_DEBUG=y
CONFIG_BACKPORTS_MAC80211_MESH_PS_DEBUG=y

# Power management
CONFIG_BACKPORTS_POWER_MANAGEMENT=y
CONFIG_PM=y
CONFIG_PM_SLEEP=y
CONFIG_PM_RUNTIME=y

# Cryptographic support
CONFIG_BACKPORTS_WIRELESS_CRYPTO=y
CONFIG_CRYPTO=y
CONFIG_CRYPTO_ARC4=y
CONFIG_CRYPTO_ECB=y
CONFIG_CRYPTO_AES=y
CONFIG_CRYPTO_CMAC=y
CONFIG_CRYPTO_CCMP=y
CONFIG_CRYPTO_GCMP=y
CONFIG_CRYPTO_SHA1=y
CONFIG_CRYPTO_SHA256=y
CONFIG_CRYPTO_MICHAEL_MIC=y

# LED support
CONFIG_BACKPORTS_LEDS_CLASS=y
CONFIG_BACKPORTS_LEDS_TRIGGERS=y
CONFIG_BACKPORTS_LEDS_TRIGGER_WIFI=y

# Debugging and diagnostics
CONFIG_BACKPORTS_DEBUG=y
CONFIG_BACKPORTS_STATISTICS=y
CONFIG_BACKPORTS_DIAGNOSTICS=y
CONFIG_BACKPORTS_TRACING=y

# Firmware loading
CONFIG_BACKPORTS_FW_LOADER=y
CONFIG_BACKPORTS_FW_LOADER_USER_HELPER=y
CONFIG_BACKPORTS_FW_LOADER_USER_HELPER_FALLBACK=y

# USB support for rt2x00
CONFIG_USB=y
CONFIG_USB_SUPPORT=y

# PCI support for ath10k and iwlwifi
CONFIG_PCI=y
CONFIG_PCI_MSI=y

# SDIO support for ath10k
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_SDHCI=y

# Regulatory compliance
CONFIG_BACKPORTS_CFG80211_CRDA_SUPPORT=y
CONFIG_BACKPORTS_CFG80211_DEFAULT_PS=y
CONFIG_BACKPORTS_CFG80211_REQUIRE_SIGNED_REGDB=y
CONFIG_BACKPORTS_CFG80211_USE_KERNEL_REGDB_KEYS=y

# Advanced features
CONFIG_BACKPORTS_WIRELESS_EXT_SYSFS=y
CONFIG_BACKPORTS_LIB80211=y
CONFIG_BACKPORTS_LIB80211_CRYPT_WEP=y
CONFIG_BACKPORTS_LIB80211_CRYPT_CCMP=y
CONFIG_BACKPORTS_LIB80211_CRYPT_TKIP=y
CONFIG_BACKPORTS_LIB80211_DEBUG=y

# Network namespace support
CONFIG_NET_NS=y
CONFIG_BACKPORTS_WIRELESS_NET_NS=y

# Quality of Service
CONFIG_BACKPORTS_MAC80211_QOS=y
CONFIG_BACKPORTS_MAC80211_HT=y
CONFIG_BACKPORTS_MAC80211_VHT=y
CONFIG_BACKPORTS_MAC80211_HE=y

# Rate control algorithms
CONFIG_BACKPORTS_MAC80211_RC_MINSTREL=y
CONFIG_BACKPORTS_MAC80211_RC_MINSTREL_HT=y
CONFIG_BACKPORTS_MAC80211_RC_MINSTREL_VHT=y
CONFIG_BACKPORTS_MAC80211_RC_DEFAULT_MINSTREL=y

# Spectral scan support (ath10k specific)
CONFIG_BACKPORTS_ATH_SPECTRAL=y
CONFIG_BACKPORTS_ATH10K_SPECTRAL_SCAN=y

# Beamforming support
CONFIG_BACKPORTS_MAC80211_BEAMFORMING=y
CONFIG_BACKPORTS_WIRELESS_BEAMFORMING=y

# Multi-user MIMO
CONFIG_BACKPORTS_MAC80211_MU_MIMO=y
CONFIG_BACKPORTS_WIRELESS_MU_MIMO=y